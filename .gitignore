# --- 원본 데이터 (용량이 큰 PDF 원본은 커밋하지 않음) ---
data/raw/*
!data/raw/.gitkeep

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- DB / 인덱스 산출물 ---
*.db
*.sqlite
*.sqlite3
db/*
!db/.gitkeep

# --- 환경 변수 / 비밀값 ---
.env
.env.*
!.env.example

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- 작업용 의사결정 초안 (정리 후 별도로 커밋 예정) ---
docs/decisions.md

# --- 청킹 산출물 (build_chunks.py로 재생성) ---
data/processed/*.jsonl

# --- 배포 꾸러미 (API 키 포함될 수 있음) ---
dist/

# --- 파일럿 실행·채점 결과 (최종본만 골라 커밋) ---
eval/runs/
